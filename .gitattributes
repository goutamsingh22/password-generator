# Normalise line endings to LF in the repository and in the working tree.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
